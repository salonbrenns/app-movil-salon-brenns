{
  "expo": {
    "name": "appmovil_Brenns",
    "slug": "appmovil_Brenns",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/brenns-app-icon.png",
    "scheme": "appmovilbrenns",
    "userInterfaceStyle": "light",
    "android": {
      "package": "com.salonbrenns.appmovilbrenns",
      "versionCode": 1,
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/images/brenns-adaptive-icon.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/brenns-app-icon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/brenns-splash-logo.png",
          "imageWidth": 200,
          "resizeMode": "contain"
        }
      ],
      "expo-secure-store",
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ],
      "expo-image",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {
        "asyncRoutes": {
          "web": true
        }
      },
      "eas": {
        "projectId": "1abbd4c4-28af-4d6f-896c-36a51f4d0492"
      }
    },
    "owner": "benildem"
  }
}
